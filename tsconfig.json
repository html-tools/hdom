{
  "compilerOptions": {
    "allowJs": true,
    "allowImportingTsExtensions": true,
    "checkJs": true,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "module": "nodenext",
    "newLine": "lf",
    "noEmit": true,
    "rootDir": ".",
    "skipLibCheck": false,
    "strict": true
  }
}
